
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Resumen</a></li>
    <li class="breadcrumb-item active">Usuarios</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-users me-1"></i> Lista de Usuarios
    </div>
    <div class="card-body">

        <div class="row">

            <div class="col-12 mb-3">

                <button type="button" class="btn btn-success " onclick="abrirModal(null)">Crear nuevo usuario</button>

            </div>
            <hr  class="mb-4"/>


            <table id="table_usuarios" class="display cell-border" style="width:100%">

                <thead>
                    <tr>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Correo</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>


                </thead>
                <tbody>
                </tbody>


            </table>

        </div>

    </div>

</div>



<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Usuario</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body ">

                <input id="txtId" type="text" value="0" />

                <div class="row g-2">

                    <div class="col-sm-6">
                        <label for="txtNombres" class="form-label">Nombres</label>
                        <input type="text" class="form-control" id="txtNombres">
                    </div>

                    <div class="col-sm-6">
                        <label for="txtApellidos" class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="txtApellidos">

                    </div>

                    <div class="col-sm-6">
                        <label for="txtEmail" class="form-label">Correo</label>
                        <input type="email" class="form-control" id="txtEmail" placeholder="name@example.com">

                    </div>

                    <div class="col-sm-6">
                        <label for="cmbActivo" class="form-label">Activo</label>
                        <select id="cmbActivo" class="form-select">
                            <option selected>Seleccione</option>
                            <option value="1">Si</option>
                            <option value="0">No</option>

                        </select>

                    </div>



                </div>

                <div class="row mt-2">
                    <div class="col-12">

                        <div id="mensajeError" class="alert alert-danger" role="alert">
                            A simple danger alert—check it out!
                        </div>


                    </div>


                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="guardarUsuario()">Guardar</button>
            </div>
        </div>
    </div>
</div>


@section scripts{

   
    <script>

        var tablaUsuarios;
        var filaSeleccionada;

            tablaUsuarios = $("#table_usuarios").DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    url: '@Url.Action("ListarUsuarios","Home")',
                    type: "GET",
                    dataType: "json"
                },
                "columns": [

                    { "data": "NOMBRE" },
                    { "data": "APELLIDO" },
                    { "data": "CORREO" },

                    {
                        "data": "ACTIVO", "render": function (valor) {
                            if (valor) {
                                return '<span class="badge text-bg-success">SHI</span>'

                            } else {
                                return '<span class="badge text-bg-danger">ÑO</span>'
                            }



                        }

                    },
                    {
                        "defaultContent": ' <button type="button" class="btn btn-primary btn-sm btn-editar"> <i class="fas fa-pen "></i> </button>' +
                            ' <button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"> <i class="fas fa-trash "></i> </button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "70px"

                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/2.3.7/i18n/es-ES.json"
                }



            });

        function abrirModal(json) {


            $("#txtId").val(0);
            $("#txtNombres").val("");
            $("#txtApellidos").val("");
            $("#txtEmail").val("");
            $("#cmbActivo").val(1);
            $("#mensajeError").hide();


            if (json != null) {
                $("#txtId").val(json.ID_USUARIO);
                $("#txtNombres").val(json.NOMBRE);
                $("#txtApellidos").val(json.APELLIDO);
                $("#txtEmail").val(json.CORREO);
                $("#cmbActivo").val(json.ACTIVO == true ? 1 : 0);
            }

            console.log(json);


            $("#FormModal").modal("show")

        }

        $("#table_usuarios tbody").on("click", '.btn-editar', function () {

             filaSeleccionada = $(this).closest("tr");

            var data = tablaUsuarios.row(filaSeleccionada).data();

            abrirModal(data)


        })

        $("#table_usuarios tbody").on("click", '.btn-eliminar', function () {

            var usuarioSeleccionado = $(this).closest("tr");

            var data = tablaUsuarios.row(usuarioSeleccionado).data();

            swal({
                title: "Esta seguro?",
                text: "Desea eliminar a este usuario? esta accion es ireversible",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Si",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: false
            },
                function (isConfirm) {

                    jQuery.ajax({
                        url: '@Url.Action("EliminarUsuario", "Home")',
                        type: "POST",
                        data: JSON.stringify({ id: data.ID_USUARIO }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {

                            debugger;

                            if (data.resultado) {
                                if (isConfirm) {
                                    tablaUsuarios.row(usuarioSeleccionado).remove().draw();
                                    swal("Usuario eliminado!", "El usuario seleccionado fue eliminado con exito", "success");
                                }
                                else {
                                    swal("Cancelled", "Your imaginary file is safe :)", "error");
                                }
                            } else {
                                swal("Nose pudo eliminar", data.mensaje, "error");
                            }
                        },
                        error: function (error) {
                            console.log(error)
                        },
                      
                    });
                    
                });

            console.log(data);


        })


        function guardarUsuario() {

            var USUARIOS = {

                ID_USUARIO: parseInt($("#txtId").val()) || 0,
                ACTIVO: $("#cmbActivo").val() == 1 ? true : false,
                NOMBRE: $("#txtNombres").val(),
                APELLIDO: $("#txtApellidos").val(),
                CORREO: $("#txtEmail").val()

            }


            jQuery.ajax({

                url: '@Url.Action("GuardarUsuario", "Home")',
                type: "POST",
                data: JSON.stringify({ usuario: USUARIOS }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    $(".modal-body").LoadingOverlay("hide");

                    //Usuario nuevo
                    if (USUARIOS.ID_USUARIO == 0) {
                        if (data.resultado != 0) {

                            USUARIOS.ID_USUARIO = data.resultado;
                            tablaUsuarios.row.add(USUARIOS).draw(false);
                            $("#FormModal").modal("hide");

                        } else {
                            $("#mensajeError").text(data.mensaje);
                            $("#mensajeError").show();
                        }
                    }

                    //Usuario actualizar
                    else {
                        if (data.resultado != null && data.resultado.ID_USUARIO > 0) {
                            tablaUsuarios.row(filaSeleccionada).data(data.resultado).draw(false);
                            filaSeleccionada = null;
                            $("#FormModal").modal("hide");
                            alert(data.mensaje);
                        } else {
                            $("#mensajeError").text(data.mensaje);
                            $("#mensajeError").show();
                        }

                    }


                }, error: function (error) {
                    $(".modal-body").LoadingOverlay("hide");
                    console.log("Error en la petición AJAX:", error);
                    alert("Ocurrió un error de conexión.");
                },
                beforeSend: function () {
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando..",
                        size: 14
                    })

                }
            });
        }
        

    </script>
}

