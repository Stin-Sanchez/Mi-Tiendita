@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión - Mi Sistema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">










    <style>
        body {
            background-color: #f8f7f4; /* Blanco hueso cálido */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

            /* Acento decorativo en la esquina superior */
            body::before {
                content: '';
                position: fixed;
                top: -120px;
                right: -120px;
                width: 400px;
                height: 400px;
                background: radial-gradient(circle, rgba(13,110,253,0.12) 0%, transparent 70%);
                pointer-events: none;
                z-index: 0;
            }

            body::after {
                content: '';
                position: fixed;
                bottom: -100px;
                left: -100px;
                width: 350px;
                height: 350px;
                background: radial-gradient(circle, rgba(13,110,253,0.08) 0%, transparent 70%);
                pointer-events: none;
                z-index: 0;
            }

        .card-login {
            border: 1px solid rgba(13,110,253,0.12);
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(13,110,253,0.08), 0 20px 40px -8px rgba(13,110,253,0.12);
            background: #ffffff;
            position: relative;
            z-index: 1;
        }

          
        .icon-wrapper {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #0d6efd, #6ea8fe);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(13,110,253,0.35);
        }

        /* Focus con azul Bootstrap */
        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(13,110,253,0.20);
            border-color: #0d6efd;
        }

        .form-floating label {
            color: #6c757d;
        }

        .btn-login {
            background: linear-gradient(135deg, #0d6efd, #3d8bfd);
            border: none;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            border-radius: 0.6rem;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(13,110,253,0.30);
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #0b5ed7, #0d6efd);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(13,110,253,0.40);
            }

            .btn-login:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(13,110,253,0.25);
            }

        .link-primary-custom {
            color: #0d6efd;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

            .link-primary-custom:hover {
                color: #0b5ed7;
                text-decoration: underline;
            }

        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .card-footer {
            background-color: #f8f9ff !important; /* Tinte muy suave de azul */
            border-top: 1px solid rgba(13,110,253,0.08) !important;
        }
    </style>
</head>
<body>
    <div id="layoutAuthentication" class="flex-grow-1 d-flex align-items-center">
        <div id="layoutAuthentication_content" class="w-100">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-5 col-md-7">
                            <div class="card card-login my-5">
                                <div class="card-body p-4 p-md-5">

                                    <div class="text-center mb-4">
                                        <div class="icon-wrapper">
                                            <i class="fas fa-user-lock fa-xl text-white"></i>
                                        </div>
                                        <h3 class="fw-bold mt-3 mb-1" style="color: #1a1a2e;">Bienvenido de nuevo</h3>
                                        <p class="text-muted small mb-0">Ingresa tus credenciales para acceder</p>
                                    </div>

                                    <form method="post" action="@Url.Action("Index","Acceso")">
                                        <div class="form-floating mb-3">
                                            <input class="form-control" name="correo" type="email" placeholder="nombre@ejemplo.com" required />
                                            <label for="inputEmail"><i class="fas fa-envelope me-2 text-muted"></i>Correo electrónico</label>
                                        </div>

                                        <div class="form-floating mb-3">
                                            <input class="form-control" name="clave" type="password" placeholder="Contraseña" required />
                                            <label for="inputPassword"><i class="fas fa-key me-2 text-muted"></i>Contraseña</label>
                                        </div>


                                        @{
                                            if (ViewBag.Error != null)
                                                        {
                                                            <div class="form-floating mb-3">
                                                                <div class="alert alert-danger" role="alert">
                                                                   @ViewBag.Error                                                                </div>
                                                            </div>
                                                        } 
                                             }


                                        <div class="d-flex align-items-center justify-content-end mb-4">

                                            <a class="small link-primary-custom" href="@Url.Action("RestablecerClave","Acceso")">¿Olvidaste tu contraseña?</a>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button class="btn btn-primary btn-login text-white" type="submit">
                                                <i class="fas fa-sign-in-alt me-2"></i>Ingresar
                                            </button>
                                        </div>
                                    </form>

                                </div>
                              
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div id="layoutAuthentication_footer">
        <footer class="py-4 mt-auto">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center justify-content-center small text-muted">
                    <div class="me-3">Copyright &copy; Tu Empresa 2023</div>
                    <div>
                        <a href="#" class="text-muted text-decoration-none me-2">Privacidad</a>
                        &middot;
                        <a href="#" class="text-muted text-decoration-none ms-2">Términos</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
