@model ENTIDADES.CLIENTES
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registrar Cuenta - Mi Sistema</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        body {
            /* Un fondo claro similar al de tu login */
            background-color: #f4f7fc;
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        .registro-card {
            border: none;
            border-radius: 16px; /* Esquinas más suaves */
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important; /* Sombra sutil */
        }

        .icono-cabecera {
            width: 70px;
            height: 70px;
            background-color: #2d7cf6; /* Azul brillante de tu botón */
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            box-shadow: 0 4px 10px rgba(45, 124, 246, 0.3);
        }
        /* Estilos para que el ícono se vea integrado en el input */
        .input-group-text {
            background-color: #ffffff;
            border-right: none;
            color: #6c757d;
        }

        .form-control {
            border-left: none;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #ced4da; /* Evita el brillo azul feo al hacer clic */
            }

        .input-group:focus-within {
            box-shadow: 0 0 0 0.25rem rgba(45, 124, 246, 0.25);
            border-radius: 0.375rem;
        }

            .input-group:focus-within .input-group-text,
            .input-group:focus-within .form-control {
                border-color: #2d7cf6;
                color: #2d7cf6;
            }

        .btn-principal {
            background-color: #2d7cf6;
            border: none;
            border-radius: 8px;
            font-weight: 500;
            padding: 10px;
        }

            .btn-principal:hover {
                background-color: #1b63d1;
            }

        a {
            color: #2d7cf6;
            text-decoration: none;
            font-weight: 500;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center mt-5 mb-5">
                        <div class="col-lg-6 col-md-8">

                            <div class="card registro-card mt-4">
                                <div class="card-body p-5">

                                    <div class="text-center mb-4">
                                        <div class="icono-cabecera mb-3">
                                            <i class="bi bi-person-plus-fill fs-1"></i>
                                        </div>
                                        <h3 class="fw-bold mb-1">Crear Cuenta</h3>
                                        <p class="text-muted small">Únete a nosotros ingresando tus datos</p>
                                    </div>

                                    <form action="@Url.Action("Registrar", "Acceso")" method="post">

                                        <div class="row mb-3">
                                            <div class="col-md-6 mb-3 mb-md-0">
                                                @Html.Label("txtNombre", "Nombres", new { @class = "form-label fw-bold text-muted small" })
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                                    @Html.TextBoxFor(m => m.NOMBRE, new { @class = "form-control", @id = "txtNombre", @placeholder = "Ingresa tus nombres", value = ViewData["NOMBRE"] })
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                @Html.Label("txtApellido", "Apellidos", new { @class = "form-label fw-bold text-muted small" })
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                                    @Html.TextBoxFor(m => m.APELLIDO, new { @class = "form-control", @id = "txtApellido", @placeholder = "Ingresa tus apellidos", value = ViewData["APELLIDO"] })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            @Html.Label("txtCorreo", "Correo electrónico", new { @class = "form-label fw-bold text-muted small" })
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                                @Html.TextBoxFor(m => m.CORREO, new { @class = "form-control", @id = "txtCorreo", @type = "email", @placeholder = "ejemplo@correo.com", @required = "required" })
                                            </div>
                                        </div>

                                        <div class="row mb-4">
                                            <div class="col-md-6 mb-3 mb-md-0">
                                                @Html.Label("txtClave", "Contraseña", new { @class = "form-label fw-bold text-muted small" })
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                                                    @Html.PasswordFor(m => m.CLAVE, new { @class = "form-control", @id = "txtClave", @placeholder = "Crea una contraseña", @required = "required" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                @Html.Label("txtConfirmarClave", "Confirmar Contraseña", new { @class = "form-label fw-bold text-muted small" })
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                                    @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control", @id = "txtConfirmarClave", @placeholder = "Confirma tu contraseña", @required = "required" })
                                                </div>
                                            </div>
                                        </div>


                                        @{ if (ViewBag.Error != null)
                                                        {
                                            <div class="row mb-4">
                                                <div class="alert alert-danger" role="alert">
                                                    @ViewBag.Error
                                                </div>
                                            </div> } }



                                        <div class="d-grid mt-4">
                                            <button type="submit" class="btn btn-primary btn-principal">
                                                <i class="bi bi-box-arrow-in-right me-2"></i>Registrarme
                                            </button>
                                        </div>

                                    </form>

                                </div>

                                <div class="card-footer bg-transparent border-0 text-center pb-4">
                                    <div class="small">
                                        ¿Ya tienes una cuenta? <a href="@Url.Action("Index","Acceso")">Inicia sesión aquí</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </main>
        </div>

        <div id="layoutAuthentication_footer">
            <footer class="py-4 mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-center small text-muted">
                        <div>Copyright &copy; Mi Tiendita 2024 &nbsp;&middot;&nbsp;</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>